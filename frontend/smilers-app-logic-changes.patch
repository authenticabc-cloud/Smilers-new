+  { code: 'NG', name: 'Nigeria', currency: 'NGN' },
+  { code: 'CI', name: "Côte d'Ivoire", currency: 'XOF' },
+  { code: 'SN', name: 'Senegal', currency: 'XOF' },
+  { code: 'CM', name: 'Cameroon', currency: 'XAF' },
+  { code: 'BF', name: 'Burkina Faso', currency: 'XOF' },
