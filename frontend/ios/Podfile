require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

require 'json'
podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

def ccache_enabled?(podfile_properties)
  # Environment variable takes precedence
  return ENV['USE_CCACHE'] == '1' if ENV['USE_CCACHE']
  
  # Fall back to Podfile properties
  podfile_properties['apple.ccacheEnabled'] == 'true'
end

ENV['RCT_NEW_ARCH_ENABLED'] ||= '0' if podfile_properties['newArchEnabled'] == 'false'
ENV['EX_DEV_CLIENT_NETWORK_INSPECTOR'] ||= podfile_properties['EX_DEV_CLIENT_NETWORK_INSPECTOR']
ENV['RCT_USE_RN_DEP'] ||= '1' if podfile_properties['ios.buildReactNativeFromSource'] != 'true' && podfile_properties['newArchEnabled'] != 'false'
ENV['RCT_USE_PREBUILT_RNCORE'] ||= '1' if podfile_properties['ios.buildReactNativeFromSource'] != 'true' && podfile_properties['newArchEnabled'] != 'false'
platform :ios, podfile_properties['ios.deploymentTarget'] || '15.1'

prepare_react_native_project!

target 'Smilers' do
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(\'expo/bin/autolinking\')',
      'expo-modules-autolinking',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  use_frameworks! :linkage => podfile_properties['ios.useFrameworks'].to_sym if podfile_properties['ios.useFrameworks']
  use_frameworks! :linkage => ENV['USE_FRAMEWORKS'].to_sym if ENV['USE_FRAMEWORKS']

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => podfile_properties['expo.jsEngine'] == nil || podfile_properties['expo.jsEngine'] == 'hermes',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => podfile_properties['apple.privacyManifestAggregationEnabled'] != 'false',
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      :ccache_enabled => ccache_enabled?(podfile_properties),
    )

    # withNonModularIncludeFix — @stream-io/react-native-webrtc builds as a
    # clang framework module yet imports non-modular React-Core headers
    # (React/RCTBridgeModule.h, RCTConvert.h, RCTEventEmitter.h,
    # RCTViewManager.h). Under -Werror=non-modular-include-in-framework-module
    # this is fatal and the iOS archive fails. Allow non-modular includes in
    # framework modules across all pod targets (canonical CocoaPods fix; does
    # not affect runtime behaviour).
    installer.pods_project.targets.each do |__nm_target|
      __nm_target.build_configurations.each do |__nm_config|
        __nm_config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end
    end

    # withExpoModulesForceLoad — CONFIRMED runtime failure: expo-modules-core
    # registers 0 native modules on iOS Release (present=0/20) even though
    # autolinking detects all of them and the AppDelegate wiring is correct.
    # With `ios.useFrameworks=static` (required by Firebase/Stream) each Expo
    # module is a STATIC framework; its Swift classes are only pulled into the
    # binary on demand. Force-load every Expo module static framework so all
    # module classes are present in the ObjC runtime at launch and
    # ExpoModulesProvider can register them (otherwise the app hangs on splash
    # because ExpoSplashScreen/ExpoConstants are null).
    # Only force-load Expo module frameworks that actually COMPILE sources into
    # a Mach-O binary (skip resource/interface-only pods that emit no binary).
    __expo_fw = installer.pods_project.targets.select do |t|
      next false unless t.respond_to?(:product_type) && t.product_type == 'com.apple.product-type.framework'
      next false unless t.name =~ /\A(Expo|EX)/
      __sbp = (t.respond_to?(:source_build_phase) ? t.source_build_phase : nil)
      __sbp && __sbp.files.count > 0
    end.map(&:name).uniq
    # The list above (__expo_fw) drives a build-time linker RESPONSE FILE — see
    # the detailed rationale in the ROOT CAUSE block below.
    puts "[withExpoModulesForceLoad] will force-load #{__expo_fw.length} Expo module frameworks via a build-time response file: #{__expo_fw.join(', ')}"

    # ==========================================================================
    # ROOT CAUSE (confirmed twice via EAS logs)
    # ==========================================================================
    # With `ios.useFrameworks=static` (required by Firebase/Stream) every Expo
    # module ships as its OWN static framework. The app's Ld step processes each
    # `-framework Foo` as a static archive and only pulls in the object files
    # that resolve a referenced symbol. Nothing references the module Swift
    # classes strongly enough, so ExpoModulesProvider finds 0 modules at launch
    # (present=0/20) and the app hangs on the splash screen with
    # `Cannot find native module 'ExpoLinking'`.
    #
    # We must force-load ONLY the Expo module frameworks (touching Fabric/Skia
    # via `-all_load` produced 78 duplicate symbols — DO NOT do that).
    #
    # PROVEN-DEAD approaches (both fail the EAS archive):
    #   1. `-all_load`                                  -> 78 duplicate symbols.
    #   2. `-force_load <abs>` OR `-Wl,-force_load,<abs>` OR
    #      `-Wl,-force_load,${PODS_CONFIGURATION_BUILD_DIR}/...` placed directly
    #      in OTHER_LDFLAGS -> Xcode's NEW build system scans OTHER_LDFLAGS,
    #      resolves the build variable, registers each framework binary path as
    #      a REQUIRED build input, and validates it during dependency-graph
    #      construction (before the sibling pod targets emit it) => the archive
    #      dies with "Build input files cannot be found: .../ExpoLinking". This
    #      was CONFIRMED from the real Ld command in the EAS logs: the flags DID
    #      resolve to absolute paths and STILL tripped input validation.
    #
    # WORKING approach — LINKER RESPONSE FILE:
    #   * A pre-link Run-Script phase writes one `-Wl,-force_load,<abs binary>`
    #     line per Expo framework into `$(DERIVED_FILE_DIR)/ExpoForceLoad.resp`,
    #     resolving the products dir from `$PODS_CONFIGURATION_BUILD_DIR` at
    #     build time (in the shell env — NOT scanned by the graph builder).
    #   * OTHER_LDFLAGS references the file with clang's `@<file>` syntax. Xcode
    #     registers ONLY the single `.resp` path as an input; it is declared as
    #     the script phase's OUTPUT, so the build system schedules the script
    #     BEFORE Ld. The framework paths live INSIDE the response file and are
    #     therefore never seen by input validation. clang expands `@file` at
    #     link time and forwards the force_load directives to ld verbatim.
    #   * DEAD_CODE_STRIPPING=NO is kept as a belt-and-braces guard.
    # ==========================================================================
    __resp_flag = '@$(DERIVED_FILE_DIR)/ExpoForceLoad.resp'
    __resp_out  = '$(DERIVED_FILE_DIR)/ExpoForceLoad.resp'
    __phase_name = '[Expo] Generate ForceLoad Response File'
    __resp_script = <<~SH
      set -e
      BASE="${PODS_CONFIGURATION_BUILD_DIR:-$CONFIGURATION_BUILD_DIR}"
      OUT="${DERIVED_FILE_DIR}/ExpoForceLoad.resp"
      mkdir -p "${DERIVED_FILE_DIR}"
      : > "$OUT"
      for n in #{__expo_fw.join(' ')}; do
        echo "-Wl,-force_load,${BASE}/${n}/${n}.framework/${n}" >> "$OUT"
      done
      echo "[ExpoForceLoad] wrote $(wc -l < "$OUT" | tr -d ' ') force_load entries to $OUT"
    SH

    installer.aggregate_targets.each do |__agg|
      __proj = __agg.user_project
      next unless __proj
      __proj.native_targets.each do |__ut|
        # Only the main app target needs the Expo modules force-loaded; applying
        # this to app extensions (e.g. the share extension) would force-load
        # frameworks the extension does not otherwise link and can break its Ld.
        next unless __ut.respond_to?(:product_type) && __ut.product_type == 'com.apple.product-type.application'

        __ut.build_configurations.each do |__c|
          next unless __c.name == 'Release'
          __ldflags = __c.build_settings['OTHER_LDFLAGS'] || ['$(inherited)']
          __ldflags = [__ldflags] unless __ldflags.is_a?(Array)
          __ldflags << '$(inherited)' unless __ldflags.include?('$(inherited)')
          # Drop any previously-applied approaches that fail on EAS.
          __ldflags.delete('-all_load')
          __ldflags.reject! { |f| f.to_s.include?('-force_load') && f.to_s != __resp_flag }
          __ldflags << __resp_flag unless __ldflags.include?(__resp_flag)
          __c.build_settings['OTHER_LDFLAGS'] = __ldflags
          __c.build_settings['DEAD_CODE_STRIPPING'] = 'NO'
        end

        # Add the response-file generator as a pre-link script phase (idempotent).
        unless __ut.shell_script_build_phases.any? { |p| p.name == __phase_name }
          __sp = __ut.new_shell_script_build_phase(__phase_name)
          __sp.shell_path = '/bin/sh'
          __sp.shell_script = __resp_script
          __sp.input_paths = []
          __sp.output_paths = [__resp_out]
        end
      end
      __proj.save
    end

    # withPodfileResourceBundleSigning — Xcode14 resource-bundle signing fix
    installer.pods_project.targets.each do |__rb_target|
      if __rb_target.respond_to?(:product_type) && __rb_target.product_type == 'com.apple.product-type.bundle'
        __rb_target.build_configurations.each do |__rb_config|
          __rb_config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
          __rb_config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
          __rb_config.build_settings['CODE_SIGN_IDENTITY'] = ''
          __rb_config.build_settings['EXPANDED_CODE_SIGN_IDENTITY'] = ''
        end
      end
    end
    if installer.respond_to?(:target_installation_results)
      installer.target_installation_results.pod_target_installation_results.each do |__rb_name, __rb_result|
        next unless __rb_result.respond_to?(:resource_bundle_targets)
        __rb_result.resource_bundle_targets.each do |__rb_bundle|
          __rb_bundle.build_configurations.each do |__rb_config|
            __rb_config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
            __rb_config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
            __rb_config.build_settings['CODE_SIGN_IDENTITY'] = ''
            __rb_config.build_settings['EXPANDED_CODE_SIGN_IDENTITY'] = ''
          end
        end
      end
    end
  end
end
