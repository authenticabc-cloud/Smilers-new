{
  "expo": {
    "name": "Smilers",
    "slug": "smilers",
    "owner": "abcsimplesend",
    "version": "2.2.18",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smilers",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smilers.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos to send in chats and status",
        "NSPhotoLibraryUsageDescription": "Share photos from your gallery in chats",
        "NSMicrophoneUsageDescription": "Record voice notes and make voice calls",
        "NSSpeechRecognitionUsageDescription": "Recognize voice commands to call or message your contacts hands-free",
        "NSLocationWhenInUseUsageDescription": "Share your location in chats",
        "NSFaceIDUsageDescription": "Unlock Smilers securely with Face ID",
        "NSContactsUsageDescription": "Find friends who use Smilers",
        "NSPhotoLibraryAddUsageDescription": "Save photos and videos from chats to your gallery",
        "NSBluetoothAlwaysUsageDescription": "Pair panic buttons and wearables for emergency alerts",
        "NSBluetoothPeripheralUsageDescription": "Pair panic buttons and wearables for emergency alerts",
        "NSCalendarsUsageDescription": "Add follow-ups from your calls to your calendar",
        "NSCalendarsWriteOnlyAccessUsageDescription": "Add follow-ups from your calls to your calendar",
        "UIBackgroundModes": [
          "audio",
          "bluetooth-central",
          "remote-notification",
          "voip"
        ],
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      },
      "entitlements": {
        "com.apple.developer.pushkit.unrestricted-voip": true
      }
    },
    "android": {
      "package": "com.smilers.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 2295,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#E4B53B"
      },
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "smilers.online",
              "pathPrefix": "/auth/callback"
            },
            {
              "scheme": "https",
              "host": "smilers.online",
              "pathPrefix": "/auth/mobile-callback"
            },
            {
              "scheme": "https",
              "host": "smilers.online",
              "pathPrefix": "/u/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "smilers",
              "host": "auth-callback"
            },
            {
              "scheme": "smilers"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "SEND",
          "data": [
            {
              "mimeType": "text/*"
            },
            {
              "mimeType": "image/*"
            },
            {
              "mimeType": "video/*"
            },
            {
              "mimeType": "audio/*"
            },
            {
              "mimeType": "application/*"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "data": [
            {
              "mimeType": "image/*"
            },
            {
              "mimeType": "video/*"
            },
            {
              "mimeType": "application/*"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "FOREGROUND_SERVICE_LOCATION",
        "READ_CONTACTS",
        "WRITE_CONTACTS",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "MODIFY_AUDIO_SETTINGS",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_PHONE_CALL",
        "FOREGROUND_SERVICE_MICROPHONE",
        "FOREGROUND_SERVICE_CAMERA",
        "FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "ACCESS_NETWORK_STATE",
        "CHANGE_NETWORK_STATE",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_ADVERTISE",
        "USE_FULL_SCREEN_INTENT",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withCallWakeScreen.js",
      "./plugins/withWebRTCScreenshare.js",
      "./plugins/withNotifeeLocalMaven.js",
      "./plugins/withNotifeeForegroundServiceType.js",
      "./plugins/withNativeCallService.js",
      "./plugins/withPodfileResourceBundleSigning.js",
      [
        "expo-calendar",
        {
          "calendarPermission": "Add follow-ups from your calls to your calendar"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FEF9F4"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#E4B53B",
          "sounds": [
            "./assets/sounds/message_notification.mp3",
            "./assets/sounds/ringtone.mp3",
            "./assets/sounds/smilers_never_cry.mp3",
            "./assets/sounds/smilers_never_cry_1.mp3",
            "./assets/sounds/smilers_never_cry_2.mp3",
            "./assets/sounds/smilers_never_cry_3.mp3",
            "./assets/sounds/smilers_notification.mp3",
            "./assets/sounds/incallmanager_ringback.mp3",
            "./assets/sounds/message_notification_beep.mp3",
            "./assets/sounds/message_notification_followup.mp3"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Share photos from your gallery in chats",
          "cameraPermission": "Take photos to send in chats and status"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Record voice notes and make voice calls"
        }
      ],
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "Find your friends already on Smilers"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Recognize voice commands to call or message your contacts hands-free",
          "speechRecognitionPermission": "Recognize voice commands to call or message your contacts hands-free"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-media-library",
        {
          "photosPermission": "Save photos and videos from chats to your gallery",
          "savePhotosPermission": "Save photos and videos from chats to your gallery",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "enableProguardInReleaseBuilds": true,
            "extraProguardRules": "# react-native-webrtc — keep all native classes from being stripped by R8 in release builds.\n# Without these rules the org.webrtc.* classes are stripped → instant native crash on require().\n-keep class org.webrtc.** { *; }\n-keep interface org.webrtc.** { *; }\n-dontwarn org.webrtc.**\n# React Native bridge module for WebRTC\n-keep class com.oney.WebRTCModule.** { *; }\n-keep interface com.oney.WebRTCModule.** { *; }\n-dontwarn com.oney.WebRTCModule.**\n# React Native core modules that WebRTC depends on\n-keep class com.facebook.react.modules.** { *; }\n-keep class com.facebook.jni.** { *; }\n# Keep all JNI native methods\n-keepclasseswithmembernames class * { native <methods>; }\n# @twilio/video-react-native-sdk — keep the Twilio Video SDK and its namespaced WebRTC fork (tvi.webrtc).\n# R8 minification is enabled; the existing rules only keep org.webrtc.* (react-native-webrtc). Without these\n# Twilio rules R8 strips com.twilio.* / tvi.webrtc.* in release builds, so mounting the <TwilioVideo> view\n# (tapping the voice/video call button) hits missing native classes and HARD-crashes (no JS error boundary can catch it).\n-keep class com.twilio.** { *; }\n-keep interface com.twilio.** { *; }\n-dontwarn com.twilio.**\n-keep class tvi.webrtc.** { *; }\n-keep interface tvi.webrtc.** { *; }\n-dontwarn tvi.webrtc.**\n-keep class com.twiliorn.** { *; }\n-dontwarn com.twiliorn.**"
          }
        }
      ],
      "@config-plugins/react-native-webrtc",
      "expo-font",
      "expo-video",
      "react-native-ble-plx",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 10,
            "NSExtensionActivationSupportsMovieWithMaxCount": 5,
            "NSExtensionActivationSupportsFileWithMaxCount": 10
          },
          "androidIntentFilters": [
            "text/*",
            "image/*",
            "video/*",
            "application/*",
            "audio/*"
          ],
          "androidMultiIntentFilters": [
            "image/*",
            "video/*",
            "application/*"
          ],
          "disableExperimental": true
        }
      ],
      [
        "@twilio/video-react-native-sdk",
        {
          "cameraPermission": "Smilers needs your camera for video calls",
          "microphonePermission": "Smilers needs your microphone for voice and video calls"
        }
      ],
      [
        "expo-pip",
        {}
      ],
      [
        "@stream-io/video-react-native-sdk",
        {
          "addNoiseCancellation": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "aff3eee0-0f42-475a-bd4c-a6d39d9b2f7b"
      }
    }
  }
}
