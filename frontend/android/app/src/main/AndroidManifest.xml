    </activity>
    <!--
      Remove Expo's FCM service from the merged manifest so our subclass
      (SmilersCallNotificationService) is the sole MESSAGING_EVENT handler.
      The subclass calls super.onMessageReceived() for non-call messages, so
      Expo's push-notification handling is fully preserved.
    -->
    <service
        android:name="expo.modules.notifications.service.ExpoFirebaseMessagingService"
        tools:node="remove"/>

    <!-- Native FCM service — intercepts call messages before React Native. -->
    <service
        android:name="com.smilers.app.SmilersCallNotificationService"
        android:exported="false"
        android:directBootAware="true">
      <intent-filter android:priority="1">
        <action android:name="com.google.firebase.MESSAGING_EVENT"/>
      </intent-filter>
    </service>

    <!-- Decline button handler — cancels the ring notification natively. -->
    <receiver
        android:name="com.smilers.app.CallActionReceiver"
        android:exported="false"/>

    <!-- sml-011: invisible trampoline the Answer/Decline notification buttons launch
         directly, so the app opens reliably from a killed process even on OEMs
         (Samsung/Motorola) with aggressive background-activity-launch restrictions. -->
    <activity
        android:name="com.smilers.app.CallActionTrampolineActivity"
        android:exported="false"
        android:theme="@style/Theme.CallActionTrampoline"
        android:excludeFromRecents="true"
        android:noHistory="true"
        android:launchMode="singleInstance"/>
  </application>
